*.iml
.gradle
/local.properties
/build
/captures
.externalNativeBuild
.cxx
local.properties

# KMP specific
.kotlin/
kotlin-js-store/

# Validation and build scripts (generated)
validate-ios-build.sh

# macOS specific
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# IDE files
# Shared project settings are versioned, per-user state is not. Note this excludes the
# *contents* of .idea rather than the directory itself: with `/.idea/` git would not
# descend into it and the negations below could never match.
/.idea/*
!/.idea/.gitignore
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
!/.idea/AndroidProjectSystem.xml
!/.idea/kotlinc.xml
!/.idea/migrations.xml
!/.idea/runConfigurations.xml
!/.idea/vcs.xml
*.iws

# Build outputs
**/build/
iosApp/Config.xcconfig
