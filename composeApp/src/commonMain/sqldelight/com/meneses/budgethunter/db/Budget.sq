CREATE TABLE budget (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  amount REAL NOT NULL,
  name TEXT NOT NULL,
  date TEXT NOT NULL,
  server_id INTEGER,
  is_synced INTEGER NOT NULL DEFAULT 0,
  last_synced_at TEXT,
  -- People with access on the server, the user included; 1 until the server says otherwise
  collaborator_count INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT
  b.*,
  COALESCE(SUM(CASE WHEN be.type = 'OUTCOME' THEN be.amount ELSE 0 END), 0) AS total_expenses,
  COALESCE(SUM(CASE WHEN be.type = 'INCOME' THEN be.amount ELSE 0 END), 0) AS total_incomes
FROM budget b
LEFT JOIN budget_entry be ON b.id = be.budget_id
GROUP BY b.id, b.amount, b.name, b.date, b.server_id, b.is_synced, b.last_synced_at, b.collaborator_count
ORDER BY b.date DESC, b.id DESC;

insert:
INSERT INTO budget (amount, name, date, server_id, is_synced, last_synced_at, collaborator_count)
VALUES (:amount, :name, :date, :server_id, :is_synced, :last_synced_at, :collaborator_count);

selectLastId:
SELECT last_insert_rowid();

update:
UPDATE budget
SET amount = :amount, name = :name, date = :date,
    -- An edit made on a copy read before the budget reached the server must not take its server
    -- id away, or the next push would create it on the server a second time.
    server_id = COALESCE(:server_id, server_id), is_synced = :is_synced, last_synced_at = :last_synced_at,
    collaborator_count = :collaborator_count
WHERE id = :id;

delete:
DELETE FROM budget
WHERE id = :id;

deleteAll:
DELETE FROM budget;

selectUnsynced:
SELECT
  b.*,
  COALESCE(SUM(CASE WHEN be.type = 'OUTCOME' THEN be.amount ELSE 0 END), 0) AS total_expenses,
  COALESCE(SUM(CASE WHEN be.type = 'INCOME' THEN be.amount ELSE 0 END), 0) AS total_incomes
FROM budget b
LEFT JOIN budget_entry be ON b.id = be.budget_id
WHERE b.is_synced = 0
GROUP BY b.id, b.amount, b.name, b.date, b.server_id, b.is_synced, b.last_synced_at, b.collaborator_count
ORDER BY b.date DESC, b.id DESC;

setServerId:
UPDATE budget
SET server_id = :server_id
WHERE id = :id;

-- Marks a pushed budget synced only while it still holds what was pushed: if it was edited
-- meanwhile it stays pending, so that edit is pushed next.
markSyncedIfUnchanged:
UPDATE budget
SET is_synced = 1, last_synced_at = :last_synced_at
WHERE id = :id
  AND name = :pushedName
  AND amount = :pushedAmount
  AND date = :pushedDate;

selectByServerId:
SELECT
  b.*,
  COALESCE(SUM(CASE WHEN be.type = 'OUTCOME' THEN be.amount ELSE 0 END), 0) AS total_expenses,
  COALESCE(SUM(CASE WHEN be.type = 'INCOME' THEN be.amount ELSE 0 END), 0) AS total_incomes
FROM budget b
LEFT JOIN budget_entry be ON b.id = be.budget_id
WHERE b.server_id = ?
GROUP BY b.id, b.amount, b.name, b.date, b.server_id, b.is_synced, b.last_synced_at, b.collaborator_count;

selectById:
SELECT
  b.*,
  COALESCE(SUM(CASE WHEN be.type = 'OUTCOME' THEN be.amount ELSE 0 END), 0) AS total_expenses,
  COALESCE(SUM(CASE WHEN be.type = 'INCOME' THEN be.amount ELSE 0 END), 0) AS total_incomes
FROM budget b
LEFT JOIN budget_entry be ON b.id = be.budget_id
WHERE b.id = ?
GROUP BY b.id, b.amount, b.name, b.date, b.server_id, b.is_synced, b.last_synced_at, b.collaborator_count;

selectSyncedServerIds:
SELECT server_id FROM budget
WHERE server_id IS NOT NULL;

deleteEntriesByBudgetServerIds:
DELETE FROM budget_entry
WHERE budget_id IN (SELECT id FROM budget WHERE server_id IN ?);

deleteByServerIds:
DELETE FROM budget
WHERE server_id IN ?;

deleteEntriesOfSyncedBudgets:
DELETE FROM budget_entry
WHERE budget_id IN (SELECT id FROM budget WHERE server_id IS NOT NULL);

deleteSynced:
DELETE FROM budget
WHERE server_id IS NOT NULL;

updateCollaboratorCount:
UPDATE budget
SET collaborator_count = :collaborator_count
WHERE server_id = :server_id;

countUnsynced:
SELECT COUNT(*) FROM budget WHERE is_synced = 0;
