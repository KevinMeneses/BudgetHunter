import com.meneses.budgethunter.budgetEntry.domain.BudgetEntry.Type;
import com.meneses.budgethunter.budgetEntry.domain.BudgetEntry.Category;

CREATE TABLE budget_entry (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  budget_id INTEGER NOT NULL,
  amount REAL NOT NULL,
  description TEXT NOT NULL,
  type TEXT AS Type NOT NULL,
  date TEXT NOT NULL,
  invoice TEXT,
  category TEXT AS Category NOT NULL,
  server_id INTEGER,
  is_synced INTEGER NOT NULL DEFAULT 0,
  created_by_email TEXT,
  updated_by_email TEXT,
  creation_date TEXT,
  modification_date TEXT,
  FOREIGN KEY (budget_id) REFERENCES budget(id) ON DELETE CASCADE
);

selectAllByBudgetId:
SELECT * FROM budget_entry
WHERE budget_id = :budgetId
ORDER BY date DESC, id DESC;

insert:
INSERT INTO budget_entry (id, budget_id, amount, description, type, date, invoice, category, server_id, is_synced, created_by_email, updated_by_email, creation_date, modification_date)
VALUES (:id, :budgetId, :amount, :description, :type, :date, :invoice, :category, :server_id, :is_synced, :created_by_email, :updated_by_email, :creation_date, :modification_date);

update:
UPDATE budget_entry
SET budget_id = :budgetId, amount = :amount, description = :description, type = :type, date = :date, invoice = :invoice, category = :category,
    -- An edit made on a copy read before the entry reached the server must not take its server id
    -- away, or the next push would create it on the server a second time.
    server_id = COALESCE(:server_id, server_id), is_synced = :is_synced, created_by_email = :created_by_email, updated_by_email = :updated_by_email, creation_date = :creation_date, modification_date = :modification_date
WHERE id = :id;

setServerId:
UPDATE budget_entry
SET server_id = :server_id
WHERE id = :id;

-- Stores the server's answer to a push only while the row still holds what was pushed: if it was
-- edited meanwhile it stays pending, so that edit is pushed next instead of being marked synced.
-- The invoice is not sent to the server, so it is neither compared nor written. The pushed amount
-- comes from the same String -> REAL conversion the row was written with, so equal values compare
-- equal; were the two ever converted differently, the row would only stay pending (one more push).
markPushedIfUnchanged:
UPDATE budget_entry
SET amount = :amount, description = :description, type = :type, date = :date, category = :category,
    is_synced = 1, created_by_email = :created_by_email, updated_by_email = :updated_by_email,
    creation_date = :creation_date, modification_date = :modification_date
WHERE id = :id
  AND amount = :pushedAmount
  AND description = :pushedDescription
  AND type = :pushedType
  AND date = :pushedDate
  AND category = :pushedCategory;

deleteByIds:
DELETE FROM budget_entry
WHERE id IN ?;

deleteAllByBudgetId:
DELETE FROM budget_entry
WHERE budget_id = ?;

deleteAll:
DELETE FROM budget_entry;

selectUnsynced:
SELECT * FROM budget_entry WHERE is_synced = 0;

selectUnsyncedByBudgetId:
SELECT * FROM budget_entry WHERE budget_id = :budgetId AND is_synced = 0;

selectByServerId:
SELECT * FROM budget_entry WHERE server_id = ?;

selectByUniqueFields:
SELECT * FROM budget_entry
WHERE budget_id = :budgetId
  AND amount BETWEEN :amount - 0.001 AND :amount + 0.001
  AND description = :description
  AND creation_date = :creationDate;

countUnsynced:
SELECT COUNT(*) FROM budget_entry WHERE is_synced = 0;
